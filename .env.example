# Copia este archivo a .env y rellena los valores. NO se versiona el .env real.

# Entorno: dev | desktop | test
APP_ENTORNO=dev

# Clave secreta de Django (genera una distinta por instalación)
# python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=cambia-esta-clave-en-produccion

# Activar modo depuración (solo dev). En 'desktop' se fuerza a False.
DJANGO_DEBUG=True

# --- Base de datos ---
# PRODUCCIÓN (Supabase, session pooler, puerto 5432, SSL obligatorio):
#   DATABASE_URL=postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# DESARROLLO (Postgres local):
DATABASE_URL=postgres://postgres:postgres@localhost:5432/biblioteca

# Base de datos para las pruebas (Postgres; los tests usan features de PostgreSQL)
DATABASE_TEST_URL=postgres://postgres:postgres@localhost:5432/biblioteca_test

# --- Parámetros operativos ---
# Cierre de sesión por inactividad, en segundos (por defecto 30 min)
SESSION_INACTIVIDAD_SEGUNDOS=1800

# Ventana de retención de datos personales de prestatarios, en días (RGPD; 2 años)
RETENCION_PRESTATARIOS_DIAS=730

# --- Opcional: reporte remoto de errores (desactivado por defecto) ---
# SENTRY_DSN=
